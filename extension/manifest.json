{
  "manifest_version": 3,
  "minimum_chrome_version": "141",
  "name": "流萤 StreamFirefly",
  "version": "1.0.0",
  "description": "本地优先的网页媒体发现与下载工具",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "webNavigation", "webRequest", "declarativeNetRequest", "storage", "scripting", "nativeMessaging", "sidePanel", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "dist/background.js" },
  "action": {
    "default_title": "流萤 StreamFirefly",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" }
  },
  "side_panel": { "default_path": "dist/app.html?surface=sidebar#/resources" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "capture-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": { "page": "dist/app.html?surface=options#/settings", "open_in_tab": true }
}
