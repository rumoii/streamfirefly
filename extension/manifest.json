{
  "manifest_version": 3,
  "name": "流萤 StreamFirefly",
  "version": "0.7.0",
  "description": "本地优先的网页媒体发现与下载工具",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "webNavigation", "webRequest", "declarativeNetRequest", "storage", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "流萤 StreamFirefly",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
