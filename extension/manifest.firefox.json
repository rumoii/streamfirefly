{
  "manifest_version": 3,
  "name": "流萤 StreamFirefly",
  "version": "0.3.0",
  "description": "本地优先的网页媒体发现与下载工具",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "webRequest", "storage", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "流萤 StreamFirefly", "default_popup": "popup.html", "default_icon": { "48": "icon48.png" } },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": { "gecko": { "id": "streamfirefly@example.invalid", "strict_min_version": "109.0" } }
}
