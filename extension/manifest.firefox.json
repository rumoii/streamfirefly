{
  "manifest_version": 3,
  "name": "流萤 StreamFirefly",
  "version": "1.0.7",
  "description": "本地优先的网页媒体发现与下载工具",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "webNavigation", "webRequest", "declarativeNetRequest", "storage", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["dist/background.js"] },
  "action": { "default_title": "流萤 StreamFirefly", "default_icon": { "48": "icon48.png" } },
  "sidebar_action": { "default_title": "流萤 StreamFirefly", "default_panel": "dist/app.html?surface=sidebar#/resources", "default_icon": { "48": "icon48.png" }, "open_at_install": false },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js", "capture-content.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["http://*/*", "https://*/*"], "js": ["capture-initialization.js", "capture-probe.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true }
  ],
  "options_ui": { "page": "dist/app.html?surface=options#/settings", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": {
      "id": "streamfirefly@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
